{
  "schemaVersion": 1,
  "id": "sd-profile-mqtt-dimmer",
  "category": "dimmer",
  "targetKind": "sd.profile",
  "compatiblePrefixes": [
    "SD"
  ],
  "i18n": {
    "title": "Generic MQTT Dimmer — set topic prefix",
    "summary": "MQTT · dimmer · profile.add"
  },
  "params": [
    {
      "name": "mqtt-id",
      "placeholder": "{{mqtt-id}}",
      "i18nLabel": "Profil ID",
      "type": "string",
      "default": "mqtt_dimmer",
      "secret": false,
      "required": true
    },
    {
      "name": "mqtt-prefix",
      "placeholder": "{{mqtt-prefix}}",
      "i18nLabel": "Topic prefix",
      "type": "string",
      "default": "light1",
      "secret": false,
      "required": true
    }
  ],
  "jsonBody": {
    "v": 2,
    "id": "{{mqtt-id}}",
    "name": "Generic MQTT Dimmer — set topic prefix",
    "manufacturer": "Generic",
    "protocol": "mqtt",
    "prefix": "{{mqtt-prefix}}",
    "behaviors": [
      "dimmer"
    ],
    "commands": {
      "set_value": {
        "topic": "{prefix}/set",
        "payload": "{value}",
        "min": 0,
        "max": 100,
        "step": 1
      },
      "toggle": {
        "topic": "{prefix}/set",
        "payload": "TOGGLE"
      }
    }
  },
  "source": "SynDimm/Code/neue/profiles/mqtt_dimmer.json"
}
