{
  "schemaVersion": 1,
  "id": "sd-mode-shutter-http",
  "category": "shutter",
  "targetKind": "sd.mode",
  "compatiblePrefixes": [
    "SD"
  ],
  "i18n": {
    "title": "Panjur Modu (HTTP)",
    "summary": "skapiTplSumModeShutter"
  },
  "params": [
    {
      "name": "name",
      "placeholder": "{{name}}",
      "i18nLabel": "Mod adı",
      "type": "string",
      "default": "Panjur",
      "required": true
    },
    {
      "name": "host",
      "placeholder": "{{host}}",
      "i18nLabel": "Hedef IP",
      "type": "host",
      "required": true
    },
    {
      "name": "port",
      "placeholder": "{{port}}",
      "i18nLabel": "Port",
      "type": "int",
      "default": "80",
      "min": 1,
      "max": 65535,
      "required": true
    },
    {
      "name": "profile",
      "placeholder": "{{profile}}",
      "i18nLabel": "Profil ID",
      "type": "string",
      "default": "shelly25_cover",
      "required": true
    },
    {
      "name": "step",
      "placeholder": "{{step}}",
      "i18nLabel": "Adım (step)",
      "type": "int",
      "default": "2",
      "min": 1,
      "max": 10,
      "required": true
    }
  ],
  "jsonBody": "{\"v\":2,\"behavior\":\"shutter\",\"enabled\":true,\"name\":\"{{name}}\",\"profile\":\"{{profile}}\",\"targets\":[{\"host\":\"{{host}}\",\"port\":{{port}}}],\"params\":{\"step\":{{step}},\"accel\":true,\"gestures_enabled\":true}}"
}
